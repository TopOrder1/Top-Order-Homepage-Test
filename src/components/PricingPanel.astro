---
import { offer, mailto } from "../data/site";

interface Props {
  /** 2 on the pricing page, where the panel sits straight under the h1;
      3 (default) on the homepage, under the "What it costs" h2 */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
---

<article class="package" data-reveal>
  <div class="package__head">
    <span class="package__eyebrow">One package</span>
    {
      headingLevel === 2 ? (
        <h2 class="package__name">{offer.name}</h2>
      ) : (
        <h3 class="package__name">{offer.name}</h3>
      )
    }
    <p class="package__price">
      <span class="package__amount">{offer.price}</span>
      <span class="package__unit">{offer.unit}</span>
    </p>
    <p class="package__summary">{offer.summary}</p>
    <a href={mailto("Website enquiry — The Openers")} class="btn btn--lg package__cta">
      Enquire about a build
    </a>
    <p class="package__deposit">
      $250–400 deposit to start, the rest when it goes live.
    </p>
  </div>

  <div class="package__body">
    <p class="package__label">What's in it</p>
    <ul class="package__features">
      {
        offer.features.map((f) => (
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path
                d="M4 9.5 7.5 13 14 5.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{f}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .package {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: var(--white);
    border-radius: var(--radius-card);
    box-shadow: 0 18px 44px rgba(30, 37, 89, 0.14);
    overflow: hidden;
    /* This panel also sits on the navy band on the homepage, which sets
       color:#fff — reset it so the card's own text stays readable on white. */
    color: var(--ink);
  }

  /* out-specifies the global `.band-dark h3` rule */
  .package .package__name {
    color: var(--navy);
  }

  .package__head {
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    background: var(--cobalt-tint);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .package__eyebrow {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cobalt);
  }

  .package__name {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem);
    margin-top: 0.6rem;
  }

  .package__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 1.1rem;
  }

  .package__amount {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.25rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--navy);
  }

  .package__unit {
    font-size: 1rem;
    color: var(--ink-faint);
  }

  .package__summary {
    margin-top: 1.1rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .package__cta {
    margin-top: 1.75rem;
  }

  .package__deposit {
    margin-top: 0.9rem;
    font-size: var(--step-small);
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .package__body {
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
  }

  .package__label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .package__features {
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .package__features li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    line-height: 1.6;
  }

  .package__features svg {
    flex: none;
    margin-top: 4px;
    color: var(--cobalt);
  }

  @media (max-width: 760px) {
    .package {
      grid-template-columns: 1fr;
    }
    .package__cta {
      width: 100%;
    }
  }
</style>
