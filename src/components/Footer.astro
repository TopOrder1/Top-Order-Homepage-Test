---
import { business, nav, suburbs, mailto } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img
          src="/assets/logo-horizontal-white.png"
          alt={business.name}
          width="299"
          height="83"
          loading="lazy"
        />
        <p>{business.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="site-footer__heading">Pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/contact">Email me</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="site-footer__heading">Get in touch</h2>
        <ul>
          <li><a href={mailto("Website enquiry")}>{business.email}</a></li>
          <li><a href={business.phoneHref}>{business.phone}</a></li>
          <li><span>ABN {business.abn}</span></li>
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Where I work</h2>
        <ul class="site-footer__suburbs">
          {suburbs.map((s) => <li><span class="tag--ghost tag">{s}</span></li>)}
        </ul>
      </div>
    </div>

    <div class="site-footer__base">
      <span>© {year} {business.name} · {business.owner}</span>
      <div class="site-footer__legal">
        <a href="/privacy">Privacy policy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--on-dark-muted);
    border-radius: var(--radius-section) var(--radius-section) 0 0;
    margin-inline: 12px;
    /* matches the dark bands elsewhere on the site */
    padding-block: var(--band-y) 2.5rem;
    /* room for the mobile sticky CTA */
    padding-bottom: calc(2.5rem + 88px);
  }

  @media (min-width: 861px) {
    .site-footer {
      padding-bottom: 2.5rem;
    }
  }

  .site-footer__grid {
    display: grid;
    gap: 40px 56px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .site-footer img {
    height: 40px;
    width: auto;
  }

  .site-footer__brand p {
    margin-top: 20px;
    max-width: 300px;
    line-height: 1.7;
    color: var(--on-dark-muted);
  }

  .site-footer__heading {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer a {
    color: var(--on-dark-muted);
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer__suburbs {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-footer__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: var(--step-small);
    color: var(--on-dark-faint);
  }

  .site-footer__legal {
    display: flex;
    gap: 24px;
  }

  .site-footer__base a {
    color: var(--on-dark-faint);
  }
</style>
